#!/bin/sh
# agentgraph launcher. Run it from a project directory.
#   agentgraph                      live view of the agent graph and the current task graph
#   agentgraph check                validate the task-graph files
#   agentgraph record               save finished graphs to the run ledger
#   agentgraph feedback --stdin     save a correction from the user, read from stdin (--agent NAME, --task NAME)
#   agentgraph signals [--json]     what the ledger says should improve
#   agentgraph improved ...         mark that a prompt improvement was applied
#   agentgraph cases [--agent A] [--held-out | --tune] [--json]   past failures kept to try a prompt edit on (--brief ID, --result ID ...)
#   agentgraph serve [--port N]     the same view as a local web page (http://127.0.0.1:4747/)
#   agentgraph snapshot             the data behind the view, as one line of JSON
#   agentgraph structure flows      the drawn flows, the user's paths (--stats: how their runs went)
#   agentgraph flow add A B [C ...] add a path (flow text ID / flow name ID [NAME] / flow command ID --on|--off /
#                                   flow prompt ID --goal-file F|- / flow remove ID; --structure DIR, --commands DIR)
#   agentgraph structure teams      the groups: agents that report to one lead (team add LEAD MEMBER ... / team members ID MEMBER ... /
#                                   team text ID --text-file F|- / team remove ID; --structure DIR)
#   agentgraph skills show AGENT    an agent's skills (skills add|remove AGENT SKILL, skills all AGENT; --json, --config ...)
#   agentgraph agent list           the agents in the presets and agent files (agent add NAME --model M ... | --copy-of A, agent remove NAME,
#                                   agent rename NAME TO, agent restore RECORD; --config, --map, --backups, --structure, --commands)
#   agentgraph skill show ID        a skill's text (skill create ID / write ID --text-file F|-, skill delete ID, skill restore RECORD)
#   agentgraph output read TASK NODE ARTIFACT   a step's output (output write ... --text-file F|- [--expect REV] /
#                                   output restore RECORD; --dir DIR or --from DIR, --home DIR, --backups DIR)
#   agentgraph preset show          the default preset, the presets and what overrides it (preset switch NAME / preset restore RECORD;
#                                   --json, --config FILE, --backups DIR, --dir PROJECT)
#   agentgraph setup save NAME      save the managed files as a named setup (setup list / show NAME / restore NAME / undo RECORD /
#                                   remove NAME; save --replace; --config-dir, --orchestration, --json)
#   agentgraph spend limit AMOUNT   the project's spend limit in dollars (--warn AMOUNT; spend limit --off; spend show [--json]; --dir PROJECT)
#   agentgraph cost [--session ID]  where one chat's money went, and what would have made it cheaper
#   agentgraph cost --trend         cost per turn over time, split at each change to the cost settings
#   agentgraph bloat [--json]       the fixed text each agent's turn costs, dead weight, what piles up (--set-baseline)
#   agentgraph chat --session ID    one session's recent chat as plain text: reasoning, messages, tool names (--limit N, --json, --chars N, --demo)
#   agentgraph sidechat ask --main ID --text-file F|-   ask the read-only side chat (sidechat status|brief|install|uninstall|undo; --json, --demo)
#   agentgraph route [--json]       who gets which work, from the structure folder (route use-when NAME --text T,
#                                   route restore RECORD; flow scaffold P --task T writes a path's task graph)
#   agentgraph status --task T [--json]    read-only resume view: ready, running (live/quiet/orphan), returned, stale, stall candidates
#   agentgraph bench scratch-config --to DIR   a fixed-task bench on a scratch copy of the config (bench run|probe|report|scenarios)
# -P: do not put the current directory on the import path, so a project that
# has its own "agentgraph" package cannot shadow this tool.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
# "--home DIR <ledger command>" is also accepted.
if [ "$1" = "--home" ] && [ $# -ge 3 ]; then
  PYTHONPATH="$HERE" exec python3 -P -m agentgraph.ledger "$@"
fi
case "$1" in
  check)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.check "$@" ;;
  record|feedback|signals|improved)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.ledger "$@" ;;
  cases)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.cases "$@" ;;
  serve)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.server "$@" ;;
  bloat)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.bloat "$@" ;;
  cost)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.cost "$@" ;;
  chat)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.chatfeed "$@" ;;
  sidechat)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.sidechat "$@" ;;
  snapshot)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.snapshot_json "$@" ;;
  flow)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.structure "$@" ;;
  structure)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.structure "$@" ;;
  skills)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.skillset "$@" ;;
  agent)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.roster "$@" ;;
  skill)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.skillfiles "$@" ;;
  output)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.outputs "$@" ;;
  preset|setup)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.setups "$@" ;;
  spend)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.spend "$@" ;;
  team)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.teams "$@" ;;
  status)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.status "$@" ;;
  bench)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.bench "$@" ;;
  route)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.routing "$@" ;;
  *)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph "$@" ;;
esac
