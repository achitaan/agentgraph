#!/bin/sh
# agentgraph launcher. Run it from a project directory.
#   agentgraph                      live view of the agent graph and the current task graph
#   agentgraph check                validate the task-graph files
#   agentgraph record               save finished graphs to the run ledger
#   agentgraph feedback --stdin     save a correction from the user, read from stdin (--agent NAME, --task NAME)
#   agentgraph signals [--json]     what the ledger says should improve
#   agentgraph improved ...         mark that a prompt improvement was applied
#   agentgraph serve [--port N]     the same view as a local web page (http://127.0.0.1:4747/)
#   agentgraph snapshot             the data behind the view, as one line of JSON
#   agentgraph structure flows      the drawn flows (flow add A B [C ...] / flow text ID / flow remove ID)
#   agentgraph skills show AGENT    an agent's skills (skills add|remove AGENT SKILL, skills all AGENT; --json, --config ...)
#   agentgraph cost [--session ID]  where one chat's money went, and what would have made it cheaper
#   agentgraph cost --trend         cost per turn over time, split at each change to the cost settings
# -P: do not put the current directory on the import path, so a project that
# has its own "agentgraph" package cannot shadow this tool.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
# "--home DIR <ledger command>" is also accepted.
if [ "$1" = "--home" ] && [ $# -ge 3 ]; then
  PYTHONPATH="$HERE" exec python3 -P -m agentgraph.ledger "$@"
fi
case "$1" in
  check)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.check "$@" ;;
  record|feedback|signals|improved)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.ledger "$@" ;;
  serve)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.server "$@" ;;
  cost)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.cost "$@" ;;
  snapshot)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.snapshot_json "$@" ;;
  structure)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.structure "$@" ;;
  skills)
    shift
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph.skillset "$@" ;;
  *)
    PYTHONPATH="$HERE" exec python3 -P -m agentgraph "$@" ;;
esac
