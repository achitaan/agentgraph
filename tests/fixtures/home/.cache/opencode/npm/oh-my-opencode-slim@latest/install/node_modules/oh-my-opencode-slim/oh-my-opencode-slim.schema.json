{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invented schema for the test home (not the plugin's real file)",
  "type": "object",
  "properties": {
    "presets": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "agents": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "model": {"type": "string", "minLength": 1},
                    "variant": {"type": "string"},
                    "color": {"type": "string", "pattern": "^(#[0-9a-fA-F]{6}|primary|secondary|accent|success|warning|error|info)$"},
                    "description": {"type": "string"},
                    "skills": {"type": "array", "items": {"type": "string"}},
                    "mcps": {"type": "array", "items": {"type": "string"}},
                    "permission": {"type": "object", "additionalProperties": {"enum": ["allow", "deny", "ask"]}},
                    "prompt": {"type": "string"},
                    "orchestratorPrompt": {"type": "string"}
                  },
                  "required": ["model"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["agents"]
          },
          {"type": "object"}
        ]
      }
    },
    "disabled_agents": {"type": "array", "items": {"type": "string"}}
  }
}
